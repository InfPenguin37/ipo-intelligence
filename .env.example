# Copy the lines you need into your shell (export ...) before running the app.
# Live scrapers are OFF by default. Read the README section on scraping first.
IPO_ENABLE_SCRAPERS=0
# Seconds to wait between requests to the same site (be polite).
IPO_REQUEST_DELAY_S=2.5
# Issues at or above this size (Rs crore) use the "large IPO" model.
IPO_LARGE_CUTOFF_CR=5000
# Override source URLs if a site changes layout; `IPO_PERF_URL` is the Chittorgarh tracker JSON endpoint.
# IPO_GMP_URL=
# IPO_LIST_URL=
# IPO_PERF_URL=
